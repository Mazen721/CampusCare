# Server configuration — copy to server/.env and fill real values.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/campuscare?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173

# Optional. When all three are empty in development, uploads fall back to server/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional. Leave empty to exercise the AI fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Enables POST /api/v1/auth/demo-login. Set to false in production.
DEMO_MODE=true
